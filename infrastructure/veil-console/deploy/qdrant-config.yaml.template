log_level: WARN

storage:
  storage_path: /var/lib/qdrant/storage
  snapshots_path: /var/lib/qdrant/snapshots
  # The corpus is small and the box is shared with a model runtime, so memory
  # maps stay off by default and the index is rebuilt rather than kept hot.
  on_disk_payload: true

service:
  host: 127.0.0.1
  http_port: 6333
  # gRPC is not used: Veil and Console both speak the REST API with the Go
  # standard library. Leaving it off removes a listener nobody calls.
  enable_tls: false
  api_key: @@QDRANT_API_KEY@@

telemetry_disabled: true
