{
  "name": "@umbratic/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:composer": "node scripts/dev.mjs --composer-test",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:runner && tsc -p tsconfig.main.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:runner": "npm --prefix runner run build",
    "test:composer": "node scripts/test-composer-text.mjs",
    "typecheck": "npm --prefix runner run typecheck && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@umbratic/runner": "file:runner",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.3.2",
    "lucide-react": "^0.468.0",
    "pdf-to-img": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  }
}
