{
  "name": "@aegis/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k --success first \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.main.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.31",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "lucide-react": "^0.468.0",
    "opencode-ai": "^1.14.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.12",
    "wait-on": "^8.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.3"
  }
}
