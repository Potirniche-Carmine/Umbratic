{
  "name": "umbratic-ai",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "26.3.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "overrides": {
    "@electron/asar": "4.2.0",
    "@electron/get": {
      "undici": "7.29.0"
    },
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "jake": "12.10.1",
    "node-gyp": {
      "undici": "6.28.0"
    },
    "postcss": "8.5.25"
  },
  "scripts": {
    "build": "npm run desktop:build && npm run veil:build",
    "veil:build": "node scripts/build-go-services.ts",
    "desktop:dev": "npm --workspace @umbratic/desktop run dev",
    "desktop:build": "npm --workspace @umbratic/desktop run build",
    "runner:build": "npm --workspace @umbratic/runner run build",
    "veil:dev": "cd infrastructure/veil && go run ./cmd/veil",
    "local": "node scripts/run-local-veil.ts",
    "veil:test": "cd infrastructure/veil && go test ./...",
    "veil:vet": "cd infrastructure/veil && go vet ./...",
    "veil:race": "node scripts/run-go-race.ts infrastructure/veil",
    "veil-console:dev": "node scripts/run-veil-console.ts dev",
    "veil-console:smoke": "node scripts/run-veil-console.ts smoke",
    "veil-console:release": "node scripts/run-veil-console.ts release",
    "veil-console:test": "cd infrastructure/veil-console && go test ./...",
    "veil-console:vet": "cd infrastructure/veil-console && go vet ./...",
    "veil-console:race": "node scripts/run-go-race.ts infrastructure/veil-console",
    "dependencies:provision": "node scripts/provision-electron.ts",
    "supply-chain:check": "node scripts/check-supply-chain.ts",
    "supply-chain:audit": "node scripts/audit-supply-chain.ts",
    "supply-chain:sbom": "node scripts/generate-sbom.ts",
    "format:check": "cargo fmt --all -- --check",
    "lint:rust": "cargo clippy --locked --workspace --all-targets -- -D warnings",
    "source-size:check": "node scripts/check-source-size.ts",
    "quality:check": "npm run format:check && npm run lint:rust && npm run veil:vet && npm run veil-console:vet && npm run veil:race && npm run veil-console:race && npm run source-size:check",
    "verify:ci": "node scripts/verify-ci.ts",
    "test:all": "npm run supply-chain:check && npm run quality:check && npm --workspace @umbratic/pdf run test:all && npm --workspace @umbratic/runner run test:all && npm --workspace @umbratic/desktop run test:all && npm run veil:test && npm run veil-console:test && npm run desktop:build",
    "release:check": "npm run test:all && npm run build"
  }
}
