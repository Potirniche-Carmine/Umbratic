          },
          "path": {
            "description": "Workspace-relative directory path. Use \".\" for the workspace root.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
