            "maximum": 2000,
            "minimum": 1,
            "type": "integer"
          },
          "offset": {
            "description": "One-based line offset to begin reading.",
            "minimum": 1,
            "type": "integer"
          },
          "path": {
            "description": "Workspace-relative file path.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      }
    },
    "type": "function"
  },
  {
