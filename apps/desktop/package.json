{
  "name": "@umbratic/desktop",
  "private": true,
  "version": "0.0.3",
  "description": "Private AI workbench for local and company-managed models",
  "author": "Umbratic",
  "packageManager": "npm@11.20.0",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/prepare-image-runtime.ts && node scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:native && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json && vite build --config vite.preload.config.mts && npm run copy:system-skills",
    "build:runner": "npm --workspace @umbratic/runner run build",
    "build:native": "cargo build --locked --release --workspace",
    "benchmark:checkpoints": "node scripts/benchmark-checkpoints.ts",
    "copy:system-skills": "node scripts/copy-system-skills.ts",
    "generate:dmg-background": "node scripts/generate-dmg-background.ts",
    "generate:icons": "node scripts/generate-app-icons.ts",
    "prepare:package": "node scripts/prepare-package.ts",
    "package": "npm run build && npm run prepare:package && node scripts/package.ts",
    "verify:package": "node scripts/verify-package.ts",
    "test:all": "npm run build:native && npm run build:main && npm run typecheck && npm run test:native && npm run test:unit",
    "test:composer": "node tests/composer-text.test.ts",
    "test:native": "cargo test --locked --package umbratic-desktop-core --all-targets",
    "test:unit": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "generate:skill-references": "node scripts/generate-skill-references.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@napi-rs/canvas": "1.0.11",
    "@xmldom/xmldom": "0.9.12",
    "electron-updater": "6.8.9",
    "fontkit": "2.0.4",
    "jszip": "3.10.1",
    "lucide-react": "1.28.0",
    "pdf-to-img": "7.0.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@types/node": "24.13.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "license": "MIT"
}
