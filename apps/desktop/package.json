{
  "name": "@umbratic/desktop",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:runner && tsc -p tsconfig.main.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:runner": "npm --workspace @umbratic/runner run build",
    "test:all": "npm run typecheck && npm run test:unit",
    "test:composer": "node tests/composer-text.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "@umbratic/runner": "file:../../packages/runner",
    "electron": "^42.3.2",
    "lucide-react": "^1.20.0",
    "pdf-to-img": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
