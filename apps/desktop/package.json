{
  "name": "@umbratic/desktop",
  "private": true,
  "version": "0.0.3",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "npm run build:native && npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json && npm run copy:system-skills",
    "build:runner": "npm --workspace @umbratic/runner run build",
    "build:native": "cargo build --locked --release --workspace",
    "benchmark:checkpoints": "node scripts/benchmark-checkpoints.ts",
    "copy:system-skills": "node scripts/copy-system-skills.ts",
    "prepare:package": "node scripts/prepare-package.ts",
    "package": "npm run build && npm run prepare:package && electron-builder --config electron-builder.yml --publish never",
    "verify:package": "node scripts/verify-package.ts",
    "test:all": "npm run build:native && npm run build:main && npm run typecheck && npm run test:native && npm run test:unit",
    "test:composer": "node tests/composer-text.test.ts",
    "test:native": "cargo test --locked --package umbratic-desktop-core --all-targets",
    "test:unit": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "lucide-react": "1.24.0",
    "pdf-to-img": "6.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "electron": "42.4.1",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
