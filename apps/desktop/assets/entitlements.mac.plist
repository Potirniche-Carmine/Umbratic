<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron's JavaScript engine under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Native modules and the ggml backends llama-server loads at run time. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Dictation. The hardened runtime refuses the microphone outright,
         with no prompt, unless the app declares it wants one. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
