<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" />
    <parameter name="architecture" />
  </parameters>
  <!-- The branded Electron-derived launcher requires explicit Foundation
       acceptance. This list deliberately excludes all upstream libraries. -->
  <zip-file>
    <pe-file-set product-name="Umbratic" product-version="${version}">
      <include path="Umbratic.exe" />
      <include path="umbratic-runner.exe" />
      <include path="umbratic-desktop-core.exe" />
      <include path="umbratic-pdf.exe" />
      <include path="umbratic-artifacts.exe" />
      <include path="umbratic-code-index.exe" />
      <include path="veil.exe" />
      <for-each><authenticode-sign hash-algorithm="sha256" /></for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
